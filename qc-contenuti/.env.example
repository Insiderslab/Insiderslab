# Copia in .env e riempi. .env NON va committato (vedi .gitignore).

# 'typesafe' per i run reali, 'fake' per lavorare offline.
QC_PROVIDER=fake

# Chiave TypeSafe. Non metterla mai nel repository, in chat o in un ticket.
TYPESAFE_API_KEY=

# Versione PINNATA, non 'jev-latest': le soglie tarate valgono per una versione sola.
TYPESAFE_MODEL=jev-1.13.0
