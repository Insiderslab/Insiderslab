# ─── Approve by Heili — variabili d'ambiente ────────────────────────────────
# Copia questo file in .env e compila i valori. In produzione il file .env sta
# sul VPS accanto a docker-compose.prod.yml e NON va mai committato.

# ─── App ─────────────────────────────────────────────────────────────────────
# Indirizzo pubblico dell'app. In locale: http://localhost:3000
NEXTAUTH_URL=https://approve.heili.cloud
# Base dei link che ricevono i clienti (/review/...) e degli URL dei media che
# Metricool scarica. Di solito uguale a NEXTAUTH_URL.
PUBLIC_BASE_URL=https://approve.heili.cloud
# Segreto delle sessioni di login. Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=sostituisci-con-un-segreto-lungo-e-casuale
# Segreto per le chiamate del container cron a /api/cron/* (Bearer).
# Genera con: openssl rand -hex 32
CRON_SECRET=sostituisci-con-un-altro-segreto
# Chiave AES-256 (64 caratteri esadecimali) per cifrare il token Metricool e i
# link dei clienti. Genera con: openssl rand -hex 32
# Attenzione: se la cambi, token Metricool e link dei referenti non si leggono più.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Database e coda ─────────────────────────────────────────────────────────
# In produzione (docker-compose.prod.yml) l'host è "postgres" e la password
# deve coincidere con POSTGRES_PASSWORD qui sotto.
DATABASE_URL=postgresql://postgres:cambia-questa-password@postgres:5432/approve
POSTGRES_PASSWORD=cambia-questa-password
# In produzione: redis://redis:6379 — in locale: redis://localhost:6379
REDIS_URL=redis://redis:6379

# ─── Media caricati ──────────────────────────────────────────────────────────
# Cartella dei file caricati (immagini e video). In Docker è il volume
# "uploads" montato su /data/uploads sia in web sia in worker.
# In locale, se assente, si usa ./uploads.
UPLOAD_DIR=/data/uploads

# ─── Email (link di accesso dell'agenzia e notifiche) ────────────────────────
EMAIL_FROM=Approve by Heili <approve@heili.cloud>
# Opzione 1: Resend (consigliato). Chiave da https://resend.com/api-keys
RESEND_API_KEY=re_...
# Opzione 2: il tuo server SMTP. Se EMAIL_SERVER è impostato ha la precedenza
# su Resend. Codifica i caratteri speciali di utente e password (@ → %40).
# EMAIL_SERVER=smtps://approve%40heili.cloud:password@smtp.hostinger.com:465
# Senza nessuno dei due, in sviluppo le email vengono stampate in console.

# Chi può accedere al pannello dell'agenzia (separati da virgola). Senza questa
# riga chiunque raggiunga l'indirizzo può chiedere un link e crearsi un workspace.
# I clienti non fanno login: usano il loro link personale.
ALLOWED_EMAILS=stefano@insiderslab.it

# ─── Metricool ───────────────────────────────────────────────────────────────
# userId e token API si inseriscono dal pannello (Impostazioni → Metricool) e
# vengono salvati cifrati nel database: qui non serve nulla.
# METRICOOL_FAKE=1 simula Metricool senza chiamate di rete (sviluppo e test
# end-to-end). In produzione lascialo vuoto o a 0.
METRICOOL_FAKE=0
# METRICOOL_API_BASE=https://app.metricool.com/api
# Job di programmazione in parallelo nel worker.
# SCHEDULING_CONCURRENCY=3

# ─── Assistente AI di revisione (facoltativo) ────────────────────────────────
# Senza nessuna chiave l'assistente è nascosto e il portale funziona lo stesso.
# Motore: "openai" (predefinito) oppure "anthropic". Se non è impostato si usa
# OpenAI quando c'è OPENAI_API_KEY, altrimenti Claude quando c'è ANTHROPIC_API_KEY.
# Se scegli un motore senza la sua chiave, l'assistente resta spento.
REVIEW_ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Modello OpenAI (predefinito: gpt-5.5).
OPENAI_MODEL=gpt-5.5
# Alternativa: Claude di Anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# Modello Claude (predefinito: claude-opus-5-5).
# REVIEW_ASSISTANT_MODEL=claude-opus-5-5
