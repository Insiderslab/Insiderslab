// Approve by Heili — revisione e approvazione dei post dei clienti,
// con programmazione automatica su Metricool dopo l'approvazione.
//
// Auth / Workspace / Invitation sono ereditati da DM by Heili (heili-dm) e
// restano identici, così login, team e switcher funzionano allo stesso modo.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth, identico a heili-dm) ────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  postsCreated     Post[]                @relation("PostCreatedBy")
  versionsCreated  PostVersion[]         @relation("VersionCreatedBy")
  comments         PostComment[]
  events           PostEvent[]
  plansCreated     ContentPlan[]         @relation("PlanCreatedBy")
  planComments     ContentPlanComment[]
  automationTokens AutomationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspace (agenzia) ─────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Credenziali API Metricool dell'agenzia. Il token è cifrato con
  /// ENCRYPTION_KEY (AES-256-GCM, vedi lib/crypto.ts) e non lascia mai il server.
  metricoolUserId         String?
  metricoolTokenEncrypted String?
  metricoolConnectedAt    DateTime?

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  clients     Client[]
  posts       Post[]
  media       MediaAsset[]
  plans       ContentPlan[]
  automationTokens AutomationToken[]
  automationUploads AutomationUploadReservation[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ─── Clienti (= brand Metricool) ─────────────────────────────────────────────

model Client {
  reviewReminderClaimedAt DateTime?
  id              String        @id @default(cuid())
  workspaceId     String
  name            String
  /// blogId del brand su Metricool. Senza, i post approvati non possono
  /// essere programmati (restano APPROVED con errore esplicito).
  metricoolBlogId String?
  /// Fuso orario IANA del brand, es. "Europe/Rome". Usato per publicationDate.
  timezone        String        @default("Europe/Rome")
  logoUrl         String?
  /// Reti abilitate per questo cliente (valori di NETWORKS in lib/domain.ts).
  networks        String[]      @default([])
  /// Se true, il post approvato viene programmato automaticamente;
  /// se false resta APPROVED finché qualcuno dell'agenzia non lo programma.
  autoSchedule    Boolean       @default(true)
  /// Servizi attivi per questo cliente: quali tipi di contenuto l'agenzia
  /// gli prepara (post social, articoli, creatività). Mai vuoto. Si possono
  /// creare solo contenuti di un servizio attivo (e abilitato da APP_VARIANT);
  /// i contenuti già esistenti di un servizio tolto restano visibili.
  services        ContentKind[] @default([SOCIAL_POST])
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewers ClientReviewer[]
  posts     Post[]
  plans     ContentPlan[]

  @@index([workspaceId])
}

/// Persona lato cliente che approva. Accede al portale con un link personale
/// (/review/<token>), senza password. Nel DB salviamo solo l'hash del token.
model ClientReviewer {
  id             String    @id @default(cuid())
  clientId       String
  name           String
  /// Facoltativa: serve solo per le notifiche via email. Senza email l'agenzia
  /// manda il link a mano (WhatsApp, messaggio…). Postgres ammette più NULL
  /// nell'indice univoco (clientId, email).
  email          String?
  tokenHash      String    @unique
  /// Stesso token cifrato (lib/crypto.ts), per poter rimandare il link via email.
  tokenEncrypted String
  /// Se false non riceve email e il link smette di funzionare.
  active         Boolean   @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  comments          PostComment[]
  events            PostEvent[]
  reviewSessions    ReviewSession[]
  creativeDecisions CreativeDecision[]
  planComments      ContentPlanComment[]

  @@unique([clientId, email])
  @@index([clientId])
}

// ─── Post e revisioni ────────────────────────────────────────────────────────

/// Tipo di contenuto da approvare. La variante dell'app (APP_VARIANT, vedi
/// lib/variant.ts) decide quali tipi sono attivi: social (Metricool), blog e
/// ads sono a gestione interna (nessuna integrazione esterna).
enum ContentKind {
  SOCIAL_POST // post social: dopo l'approvazione va su Metricool
  BLOG_ARTICLE // articolo di blog: revisione del testo, export interno
  AD_CREATIVE // set di creatività ads (foto/video + copy) per una campagna
}

enum PostStatus {
  DRAFT // in lavorazione in agenzia, il cliente non lo vede
  IN_REVIEW // inviato al cliente, in attesa di risposta
  CHANGES_REQUESTED // il cliente ha chiesto modifiche
  APPROVED // approvato, in attesa di essere programmato
  SCHEDULING // job di programmazione su Metricool in corso
  SCHEDULED // programmato su Metricool (metricoolPostId valorizzato)
  FAILED // programmazione fallita dopo i retry (vedi lastError)
  CANCELLED // archiviato/annullato dall'agenzia
  DELIVERED // contenuti interni (blog, ads): approvato e segnato come pubblicato/consegnato dall'agenzia
}

model Post {
  /// Stable import identity scoped to the agency; prevents duplicate draft creation.
  importKey String?
  importHash String?
  @@unique([workspaceId, importKey])
  id             String      @id @default(cuid())
  workspaceId    String
  clientId       String
  /// Titolo del post, es. "Carosello lancio collezione autunno". Non viene
  /// pubblicato ma il cliente lo vede (portale, email, assistente).
  title          String
  kind           ContentKind @default(SOCIAL_POST)
  status         PostStatus  @default(DRAFT)
  /// Data/ora di pubblicazione desiderata (istante UTC). La conversione nel
  /// fuso del cliente avviene solo quando si chiama Metricool.
  publishAt      DateTime
  /// Reti di destinazione (sottoinsieme di Client.networks).
  networks       String[]
  /// Opzioni per rete nel formato Metricool, es.
  /// { "instagramData": { "type": "POST" }, "facebookData": { "type": "POST" } }
  networkOptions Json        @default("{}")

  currentVersionNumber Int @default(1)

  /// Scadenza entro cui il cliente dovrebbe rispondere (solleciti).
  reviewDueAt          DateTime?
  submittedAt          DateTime?
  approvedAt           DateTime?
  approvedByReviewerId String?

  metricoolPostId  String?
  scheduledAt      DateTime?
  lastError        String?
  scheduleAttempts Int       @default(0)

  /// Piano del mese a cui appartiene (facoltativo, vedi ContentPlan).
  planId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  versions          PostVersion[]
  comments          PostComment[]
  events            PostEvent[]
  reviewSessions    ReviewSession[]
  creativeDecisions CreativeDecision[]
  plan              ContentPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, status])
  @@index([workspaceId, status])
  @@index([clientId, status])
  @@index([publishAt])
  @@index([planId])
}

/// Ogni modifica del contenuto dopo il primo invio crea una nuova versione,
/// così il cliente vede cosa è cambiato e l'approvazione si riferisce sempre
/// a una versione precisa.
model PostVersion {
  id               String   @id @default(cuid())
  postId           String
  number           Int
  text             String
  firstCommentText String?
  /// Array di MediaItem (vedi lib/domain.ts): [{ url, type, mimeType, alt? }]
  media            Json     @default("[]")
  /// Copertina del video: istante in millisecondi (Metricool videoCoverMilliseconds).
  videoCoverMs     Int?
  /// Contenuto specifico del tipo (Post.kind), validato da lib/content/<tipo>.ts:
  /// BLOG_ARTICLE → BlogContent (corpo Markdown, SEO, immagine in evidenza…),
  /// AD_CREATIVE → AdContent (campagna + varianti con media, copy, CTA, posizionamenti).
  /// Per SOCIAL_POST resta {} (usa text/firstCommentText/media).
  content          Json     @default("{}")
  /// Nota dell'agenzia su cosa è cambiato rispetto alla versione precedente.
  changeNote       String?
  /// Data, reti e opzioni per rete di questa versione:
  /// { publishAt: ISO, networks: string[], networkOptions: {...} }. Il cliente
  /// approva anche questi, quindi una loro modifica dopo l'invio crea una nuova
  /// versione, e il portale mostra quelli della versione inviata (mai quelli di
  /// una revisione non ancora inviata). Null = righe precedenti: valgono i
  /// campi del Post.
  schedule         Json?
  createdById      String?
  createdAt        DateTime @default(now())

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("VersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments  PostComment[]

  @@unique([postId, number])
}

enum CommentAuthorType {
  AGENCY
  CLIENT
}

model PostComment {
  id         String            @id @default(cuid())
  postId     String
  versionId  String?
  authorType CommentAuthorType
  userId     String?
  reviewerId String?
  body       String
  /// Commento puntato su un media: indice nell'array media e coordinate
  /// relative 0..1. Null = commento generale.
  mediaIndex Int?
  pinX       Float?
  pinY       Float?
  /// Commento su un video (Reel, TikTok, Story video): istante in secondi e,
  /// facoltativo, fine dell'intervallo ("dal 0:05 al 0:09"). pinX/pinY, se
  /// presenti, indicano il punto sul fotogramma a quell'istante.
  timeSec    Float?
  timeEndSec Float?
  /// Blog: ancoraggio a un passaggio del testo selezionato dal cliente
  /// { quote, prefix, suffix, blockIndex } (vedi lib/content/blog.ts).
  anchor     Json?
  /// Ads: variante della creatività a cui si riferisce il commento.
  variantId  String?
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  version  PostVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewer ClientReviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([postId])
}

enum PostEventType {
  CREATED
  VERSION_CREATED
  SUBMITTED_FOR_REVIEW
  REMINDER_SENT
  CLIENT_VIEWED
  CHANGES_REQUESTED
  APPROVED
  SCHEDULE_REQUESTED
  SCHEDULED
  SCHEDULE_FAILED
  CANCELLED
  COMMENTED
  DELIVERED
  VARIANT_DECIDED
  ASSISTANT_SESSION_COMPLETED
}

/// Registro di audit: chi ha fatto cosa e quando. Mai cancellato a mano.
model PostEvent {
  id            String        @id @default(cuid())
  postId        String
  type          PostEventType
  userId        String?
  reviewerId    String?
  versionNumber Int?
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())

  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewer ClientReviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

// ─── Media ───────────────────────────────────────────────────────────────────

/// File caricato dall'agenzia. Metricool richiede URL pubblici, quindi ogni
/// file è servito da /media/<storageKey> con una chiave non indovinabile.
model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  storageKey  String   @unique
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── Assistente di revisione AI ──────────────────────────────────────────────

enum ReviewSessionStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum ReviewMessageRole {
  CLIENT
  ASSISTANT
}

enum ReviewInputMode {
  TEXT
  VOICE
}

/// Conversazione guidata tra il cliente e l'assistente AI su una versione di
/// un post. L'assistente fa domande quando il feedback è vago ("mmh, non mi
/// convince") finché non è azionabile; alla fine produce un riepilogo
/// strutturato che diventa la richiesta di modifiche per l'agenzia.
/// Tutto resta registrato (audit + storico del cliente).
model ReviewSession {
  providerAttempts ReviewProviderAttempt[]
  id            String              @id @default(cuid())
  postId        String
  reviewerId    String
  versionNumber Int
  status        ReviewSessionStatus @default(OPEN)
  /// Esito proposto dall'assistente: "approve" | "changes" | "unclear".
  verdict       String?
  /// Riepilogo in italiano per l'agenzia, scritto dall'assistente.
  summary       String?
  /// Array di ActionItem (vedi lib/review-assistant): [{ area, mediaIndex?, request, priority }]
  actionItems   Json                @default("[]")
  /// Modello che ha condotto la conversazione (tracciabilità).
  model         String?
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  /// Turno in corso (chiamata al modello): una sola richiesta alla volta per
  /// conversazione. Un valore vecchio (processo morto) scade da solo.
  turnStartedAt DateTime?

  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewer ClientReviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  messages ReviewMessage[]

  @@index([postId])
  @@index([reviewerId])
}

model ReviewProviderAttempt {
  id String @id @default(cuid())
  sessionId String
  createdAt DateTime @default(now())
  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

model AutomationUploadReservation {
  id String @id @default(cuid())
  workspaceId String
  sizeBytes Int
  expiresAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
}

model AutomationToken {
  id String @id @default(cuid())
  workspaceId String
  userId String
  name String
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

model ReviewMessage {
  id        String            @id @default(cuid())
  sessionId String
  role      ReviewMessageRole
  content   String
  inputMode ReviewInputMode   @default(TEXT)
  createdAt DateTime          @default(now())

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ─── Ads: decisione del cliente per singola variante ─────────────────────────

enum CreativeVerdict {
  APPROVED
  REJECTED
}

/// Per i set di creatività ads il cliente decide variante per variante
/// (es. approva A e C, scarta B). Legata alla versione: una nuova versione
/// richiede nuove decisioni. L'approvazione del post richiede che ogni
/// variante abbia una decisione e almeno una sia APPROVED.
model CreativeDecision {
  id            String          @id @default(cuid())
  postId        String
  versionNumber Int
  variantId     String
  reviewerId    String?
  verdict       CreativeVerdict
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  post     Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewer ClientReviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([postId, versionNumber, variantId])
  @@index([postId])
}

// ─── Piano del mese ──────────────────────────────────────────────────────────

/// Stato del piano, ricavato dai suoi post (lib/plan-rules.ts derivePlanStatus):
/// IN_REVIEW se almeno un post aspetta il cliente, CHANGES_REQUESTED se il
/// cliente ha chiesto modifiche a qualcuno, DRAFT se c'è qualcosa da (re)inviare,
/// APPROVED quando tutti i post sono approvati. La colonna è una copia
/// aggiornata da lib/plans.ts (syncPlanStatus) ogni volta che il piano si legge
/// o cambia: la verità sono gli stati dei post.
enum PlanStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

/// Piano mensile dei contenuti di un cliente ("Piano social ottobre 2026"):
/// l'agenzia presenta tutti i post del mese insieme, con un messaggio
/// introduttivo, e il cliente li rivede in un'unica pagina (griglia Instagram,
/// calendario, "Approva tutto il piano"). I post restano post: ogni
/// approvazione è sempre legata alla versione, post per post.
model ContentPlan {
  id                  String      @id @default(cuid())
  workspaceId         String
  clientId            String
  /// Tipo di contenuto del piano (oggi solo SOCIAL_POST nell'interfaccia).
  kind                ContentKind @default(SOCIAL_POST)
  /// Mese del piano come "YYYY-MM", inteso nel fuso orario del cliente:
  /// un post delle 23:30 del 31 ottobre a Roma è di ottobre.
  month               String
  title               String
  /// Messaggio dell'agenzia al cliente (strategia, note del mese).
  intro               String?
  status              PlanStatus  @default(DRAFT)
  /// Primo invio al cliente ("Invia il piano al cliente"); il cliente vede il
  /// piano solo dopo. Aggiornato a ogni nuovo invio.
  sentAt              DateTime?
  reviewDueAt         DateTime?
  /// Avviso all'agenzia "il cliente ha deciso tutti i post" già mandato per
  /// l'ultimo invio (una volta sola; azzerato a ogni nuovo invio).
  completedNotifiedAt DateTime?
  /// Lease breve per impedire che due decisioni/cron inviino lo stesso avviso.
  /// Se il processo muore durante l'invio, la lease scade e il cron riprova.
  completedNotificationClaimedAt DateTime?
  /// Dopo un fallimento definitivo dell'email, non riprovare prima di qui.
  completedNotificationRetryAt DateTime?
  createdById         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  posts     Post[]
  comments  ContentPlanComment[]

  @@unique([clientId, kind, month])
  @@index([workspaceId, month])
  @@index([completedNotifiedAt, completedNotificationRetryAt], map: "ContentPlan_completion_notification_retry_idx")
}

/// Commento generale del cliente (o risposta dell'agenzia) sul piano intero,
/// "Commento sul piano". Il feedback sul singolo post resta sul post.
model ContentPlanComment {
  id         String            @id @default(cuid())
  planId     String
  authorType CommentAuthorType
  reviewerId String?
  userId     String?
  body       String
  createdAt  DateTime          @default(now())

  plan     ContentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewer ClientReviewer? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
}
